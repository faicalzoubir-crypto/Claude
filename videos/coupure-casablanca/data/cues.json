 "groups": [
  {
   "phrase": "s1a",
   "start": 0.4,
   "end": 2.59,
   "text": "مساء الأربعاء 11 نونبر 2026،"
  },
  {
   "phrase": "s1a",
   "start": 2.59,
   "end": 4.09,
   "text": "على الساعة 16:48،"
  },
  {
   "phrase": "s1b",
   "start": 4.29,
   "end": 6.79,
   "text": "وقع عطل فخطوط الجهد العالي جدا"
  },
  {
   "phrase": "s1b",
   "start": 6.79,
   "end": 9.04,
   "text": "ديال الشبكة الوطنية لنقل الكهرباء،"
  },
  {
   "phrase": "s1c",
   "start": 9.24,
   "end": 11.77,
   "text": "تزامنا مع رياح قوية وعواصف رعدية."
  },
  {
   "phrase": "s1d",
   "start": 12.01,
   "end": 13.53,
   "text": "النتيجة: انقطع الضو"
  },
  {
   "phrase": "s1d",
   "start": 13.53,
   "end": 16.45,
   "text": "على بزاف د الأحياء فالدار البيضاء ونواحيها."
  },
  {
   "phrase": "s2a",
   "start": 17.55,
   "end": 19.73,
   "text": "هادو هما الأحياء اللي تبلّغ"
  },
  {
   "phrase": "s2a",
   "start": 19.73,
   "end": 21.55,
   "text": "على انقطاع الضو فيها"
  },
  {
   "phrase": "s2a",
   "start": 21.55,
   "end": 23.79,
   "text": "حسب الصحافة وبلاغ الشركة الجهوية."
  },
  {
   "phrase": "s2b",
   "start": 26.85,
   "end": 28.25,
   "text": "أما المضاءة،"
  },
  {
   "phrase": "s2b",
   "start": 28.25,
   "end": 30.79,
   "text": "فهي غير اللي ما ذكراتهاش التقارير،"
  },
  {
   "phrase": "s2b",
   "start": 30.79,
   "end": 32.3,
   "text": "وماشي لائحة رسمية."
  },
  {
   "phrase": "s3a",
   "start": 34.2,
   "end": 36.68,
   "text": "حسب Le360 نقلا عن مصدر مطلع،"
  },
  {
   "phrase": "s3b",
   "start": 36.88,
   "end": 38.72,
   "text": "العاصفة أثرت على تغذية"
  },
  {
   "phrase": "s3b",
   "start": 38.72,
   "end": 40.9,
   "text": "محطتي أولاد حدو ودار بوعزة،"
  },
  {
   "phrase": "s3b",
   "start": 40.9,
   "end": 43.47,
   "text": "اللي كيغذيو الجزء الجنوبي من المدينة."
  },
  {
   "phrase": "s3c",
   "start": 43.75,
   "end": 46.62,
   "text": "الشركة الجهوية ما سمات حتى محطة رسميا."
  },
  {
   "phrase": "s3d",
   "start": 46.97,
   "end": 49.17,
   "text": "هاد المحطات ماشي محطات توليد،"
  },
  {
   "phrase": "s3d",
   "start": 49.17,
   "end": 50.65,
   "text": "هي محطات تحويل:"
  },
  {
   "phrase": "s3e",
   "start": 50.85,
   "end": 52.73,
   "text": "كتستقبل الكهرباء من الخطوط"
  },
  {
   "phrase": "s3e",
   "start": 52.73,
   "end": 55.65,
   "text": "ديال الجهد العالي جدا وكتوزعها على الأحياء."
  },
  {
   "phrase": "s3f",
   "start": 55.97,
   "end": 58.51,
   "text": "فاش كيتقطع الخط اللي كيدخل للمحطة،"
  },
  {
   "phrase": "s3f",
   "start": 58.51,
   "end": 60.33,
   "text": "المحطة كتبقى بلا ضو،"
  },
  {
   "phrase": "s3f",
   "start": 60.33,
   "end": 62.55,
   "text": "وكل الأحياء اللي كتغذيها كتطفى."
  },
  {
   "phrase": "s4a",
   "start": 63.75,
   "end": 65.97,
   "text": "حسب الناطق الرسمي باسم الحكومة،"
  },
  {
   "phrase": "s4a",
   "start": 65.97,
   "end": 67.88,
   "text": "سمير بلفقيه، والشركة الجهوية:"
  },
  {
   "phrase": "s4b",
   "start": 68.12,
   "end": 70.32,
   "text": "سبب الانقطاع هو الرياح القوية"
  },
  {
   "phrase": "s4b",
   "start": 70.32,
   "end": 73.01,
   "text": "والاضطرابات الجوية اللي ضربات العاصمة الاقتصادية."
  },
  {
   "phrase": "s4c",
   "start": 73.33,
   "end": 74.83,
   "text": "شدة الرياح طيّحات"
  },
  {
   "phrase": "s4c",
   "start": 74.83,
   "end": 77.38,
   "text": "تلاتة د الكابلات ديال الجهد العالي،"
  },
  {
   "phrase": "s4d",
   "start": 77.58,
   "end": 80.54,
   "text": "من بينهم الكابل الرئيسي ديال الشبكة الكهربائية."
  },
  {
   "phrase": "s4e",
   "start": 80.86,
   "end": 83.07,
   "text": "فاش كيطيح الكابل، كيتقطع الخط،"
  },
  {
   "phrase": "s4e",
   "start": 83.07,
   "end": 85.89,
   "text": "وكل اللي كيتغذى منو كيبقى بلا ضو."
  },
  {
   "phrase": "s5a",
   "start": 88.09,
   "end": 90.99,
   "text": "باش ما يتعاودش هادشي، كاينين حلول معروفة."
  },
  {
   "phrase": "s5b",
   "start": 91.27,
   "end": 94.12,
   "text": "أولا، ربط المحطات بأكثر من خط تغذية،"
  },
  {
   "phrase": "s5b",
   "start": 94.12,
   "end": 96.92,
   "text": "باش إلا طاح خط يبقى الآخر خدام."
  },
  {
   "phrase": "s5c",
   "start": 97.24,
   "end": 100.19,
   "text": "ثانيا، فحص وصيانة الخطوط والعوازل قبل العواصف."
  },
  {
   "phrase": "s5d",
   "start": 100.51,
   "end": 103.11,
   "text": "ثالثا، حماية الخطوط والمحطات ضد الصواعق."
  },
  {
   "phrase": "s5e",
   "start": 103.43,
   "end": 104.96,
   "text": "رابعا، مراقبة الشبكة"
  },
  {
   "phrase": "s5e",
   "start": 104.96,
   "end": 107.15,
   "text": "عن قرب حسب الإنذارات الجوية."
  },
  {
   "phrase": "s5f",
   "start": 107.47,
   "end": 110.52,
   "text": "وخامسا، مولدات احتياطية للمرافق الحيوية بحال السبيطارات."
  },
  {
   "phrase": "s6a",
   "start": 113.02,
   "end": 114.42,
   "text": "سؤال مطروح:"
  },
  {
   "phrase": "s6a",
   "start": 114.42,
   "end": 117.0,
   "text": "الدار البيضاء عرفات رياح قوية فالماضي،"
  },
  {
   "phrase": "s6b",
   "start": 117.2,
   "end": 120.02,
   "text": "علاش هاد المرة تأثر أكثر من موقع؟"
  },
  {
   "phrase": "s6c",
   "start": 120.34,
   "end": 121.86,
   "text": "حسب التصريح الرسمي،"
  },
  {
   "phrase": "s6c",
   "start": 121.86,
   "end": 123.74,
   "text": "الكابل الرئيسي ديال الشبكة"
  },
  {
   "phrase": "s6c",
   "start": 123.74,
   "end": 126.24,
   "text": "كان من بين الكابلات اللي طاحو."
  },
  {
   "phrase": "s6d",
   "start": 126.56,
   "end": 129.28,
   "text": "والتفاصيل التقنية الكاملة، ننتظروها فالتقرير الرسمي."
  }
 ],
