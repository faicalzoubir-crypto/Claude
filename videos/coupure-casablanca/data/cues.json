 "groups": [
  {
   "phrase": "s1a",
   "start": 1.4,
   "end": 3.988,
   "text": "مساء الأربعاء 11 نونبر 2026،"
  },
  {
   "phrase": "s1a",
   "start": 3.988,
   "end": 5.788,
   "text": "على الساعة 16:48،"
  },
  {
   "phrase": "s1b",
   "start": 7.388,
   "end": 10.328,
   "text": "وقع عطل فخطوط الجهد العالي جدا"
  },
  {
   "phrase": "s1b",
   "start": 10.328,
   "end": 12.988,
   "text": "ديال الشبكة الوطنية لنقل الكهرباء،"
  },
  {
   "phrase": "s1c",
   "start": 14.588,
   "end": 17.564,
   "text": "تزامنا مع رياح قوية وعواصف رعدية."
  },
  {
   "phrase": "s1d",
   "start": 19.364,
   "end": 21.188,
   "text": "النتيجة: انقطع الضو"
  },
  {
   "phrase": "s1d",
   "start": 21.188,
   "end": 24.612,
   "text": "على بزاف د الأحياء فالدار البيضاء ونواحيها."
  },
  {
   "phrase": "s2a",
   "start": 28.9,
   "end": 31.476,
   "text": "هادو هما الأحياء اللي تبلّغ"
  },
  {
   "phrase": "s2a",
   "start": 31.476,
   "end": 33.64,
   "text": "على انقطاع الضو فيها"
  },
  {
   "phrase": "s2a",
   "start": 33.64,
   "end": 36.288,
   "text": "حسب الصحافة وبلاغ الشركة الجهوية."
  },
  {
   "phrase": "s2b",
   "start": 53.5,
   "end": 55.1,
   "text": "أما المضاءة،"
  },
  {
   "phrase": "s2b",
   "start": 55.1,
   "end": 58.088,
   "text": "فهي غير اللي ما ذكراتهاش التقارير،"
  },
  {
   "phrase": "s2b",
   "start": 58.088,
   "end": 59.9,
   "text": "وماشي لائحة رسمية."
  },
  {
   "phrase": "s3a",
   "start": 66.896,
   "end": 69.812,
   "text": "حسب Le360 نقلا عن مصدر مطلع،"
  },
  {
   "phrase": "s3b",
   "start": 70.579,
   "end": 72.767,
   "text": "العاصفة أثرت على تغذية"
  },
  {
   "phrase": "s3b",
   "start": 72.767,
   "end": 75.343,
   "text": "محطتي أولاد حدو ودار بوعزة،"
  },
  {
   "phrase": "s3b",
   "start": 75.343,
   "end": 78.367,
   "text": "اللي كيغذيو الجزء الجنوبي من المدينة."
  },
  {
   "phrase": "s3c",
   "start": 79.433,
   "end": 82.797,
   "text": "الشركة الجهوية ما سمات حتى محطة رسميا."
  },
  {
   "phrase": "s3d",
   "start": 84.064,
   "end": 86.664,
   "text": "هاد المحطات ماشي محطات توليد،"
  },
  {
   "phrase": "s3d",
   "start": 86.664,
   "end": 88.44,
   "text": "هي محطات تحويل:"
  },
  {
   "phrase": "s3e",
   "start": 89.206,
   "end": 91.442,
   "text": "كتستقبل الكهرباء من الخطوط"
  },
  {
   "phrase": "s3e",
   "start": 91.442,
   "end": 94.866,
   "text": "ديال الجهد العالي جدا وكتوزعها على الأحياء."
  },
  {
   "phrase": "s3f",
   "start": 96.033,
   "end": 99.021,
   "text": "فاش كيتقطع الخط اللي كيدخل للمحطة،"
  },
  {
   "phrase": "s3f",
   "start": 99.021,
   "end": 101.185,
   "text": "المحطة كتبقى بلا ضو،"
  },
  {
   "phrase": "s3f",
   "start": 101.185,
   "end": 103.809,
   "text": "وكل الأحياء اللي كتغذيها كتطفى."
  },
  {
   "phrase": "s4a",
   "start": 107.4,
   "end": 110.496,
   "text": "الفرضية: الرياح القوية كتخلي الأسلاك تتحرك."
  },
  {
   "phrase": "s4b",
   "start": 112.496,
   "end": 115.46,
   "text": "إلا تلاقا سلكين، كيوقع قصر دارة،"
  },
  {
   "phrase": "s4b",
   "start": 115.46,
   "end": 117.636,
   "text": "وكيدوز تيار قوي بزاف."
  },
  {
   "phrase": "s4c",
   "start": 119.436,
   "end": 121.648,
   "text": "أجهزة الحماية كتفصل الخط"
  },
  {
   "phrase": "s4c",
   "start": 121.648,
   "end": 125.012,
   "text": "فجزء من الثانية باش ما تتخربش المعدات،"
  },
  {
   "phrase": "s4c",
   "start": 125.012,
   "end": 126.812,
   "text": "وهنا كيتقطع الضو."
  },
  {
   "phrase": "s4d",
   "start": 129.012,
   "end": 132.024,
   "text": "هادشي فرضية، والسبب الرسمي ما تحددش،"
  },
  {
   "phrase": "s4e",
   "start": 133.624,
   "end": 136.26,
   "text": "وكاين احتمالات أخرى بحال الصاعقة"
  },
  {
   "phrase": "s4e",
   "start": 136.26,
   "end": 138.764,
   "text": "أو سقوط جسم على الخط."
  },
  {
   "phrase": "s5a",
   "start": 144.647,
   "end": 148.047,
   "text": "باش ما يتعاودش هادشي، كاينين حلول معروفة."
  },
  {
   "phrase": "s5b",
   "start": 149.716,
   "end": 153.056,
   "text": "أولا، ربط المحطات بأكثر من خط تغذية،"
  },
  {
   "phrase": "s5b",
   "start": 153.056,
   "end": 156.336,
   "text": "باش إلا طاح خط يبقى الآخر خدام."
  },
  {
   "phrase": "s5c",
   "start": 158.105,
   "end": 161.565,
   "text": "ثانيا، فحص وصيانة الخطوط والعوازل قبل العواصف."
  },
  {
   "phrase": "s5d",
   "start": 163.335,
   "end": 166.395,
   "text": "ثالثا، حماية الخطوط والمحطات ضد الصواعق."
  },
  {
   "phrase": "s5e",
   "start": 168.164,
   "end": 170.0,
   "text": "رابعا، مراقبة الشبكة"
  },
  {
   "phrase": "s5e",
   "start": 170.0,
   "end": 172.588,
   "text": "عن قرب حسب الإنذارات الجوية."
  },
  {
   "phrase": "s5f",
   "start": 174.357,
   "end": 177.937,
   "text": "وخامسا، مولدات احتياطية للمرافق الحيوية بحال السبيطارات."
  },
  {
   "phrase": "s6a",
   "start": 182.272,
   "end": 183.872,
   "text": "سؤال مطروح:"
  },
  {
   "phrase": "s6a",
   "start": 183.872,
   "end": 186.908,
   "text": "الدار البيضاء عرفات رياح قوية فالماضي،"
  },
  {
   "phrase": "s6b",
   "start": 187.729,
   "end": 191.033,
   "text": "علاش هاد المرة تأثر أكثر من موقع؟"
  },
  {
   "phrase": "s6c",
   "start": 192.253,
   "end": 194.041,
   "text": "الجواب ما مؤكدش."
  },
  {
   "phrase": "s6d",
   "start": 195.062,
   "end": 198.098,
   "text": "من الاحتمالات: اجتماع الرياح مع الرعد،"
  },
  {
   "phrase": "s6e",
   "start": 198.919,
   "end": 201.119,
   "text": "وقوع العطل فوقت الذروة،"
  },
  {
   "phrase": "s6f",
   "start": 201.94,
   "end": 205.28,
   "text": "أو خط مشترك كيغذي محطتين فنفس الوقت."
  },
  {
   "phrase": "s6g",
   "start": 206.5,
   "end": 208.312,
   "text": "ننتظرو تقرير رسمي."
  }
 ],
