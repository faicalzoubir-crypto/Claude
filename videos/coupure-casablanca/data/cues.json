 "groups": [
  {
   "phrase": "s1a",
   "start": 0.4,
   "end": 2.59,
   "text": "مساء الأربعاء 11 نونبر 2026،"
  },
  {
   "phrase": "s1a",
   "start": 2.59,
   "end": 4.09,
   "text": "على الساعة 16:48،"
  },
  {
   "phrase": "s1b",
   "start": 4.29,
   "end": 6.79,
   "text": "وقع عطل فخطوط الجهد العالي جدا"
  },
  {
   "phrase": "s1b",
   "start": 6.79,
   "end": 9.04,
   "text": "ديال الشبكة الوطنية لنقل الكهرباء،"
  },
  {
   "phrase": "s1c",
   "start": 9.24,
   "end": 11.77,
   "text": "تزامنا مع رياح قوية وعواصف رعدية."
  },
  {
   "phrase": "s1d",
   "start": 12.01,
   "end": 13.53,
   "text": "النتيجة: انقطع الضو"
  },
  {
   "phrase": "s1d",
   "start": 13.53,
   "end": 16.45,
   "text": "على بزاف د الأحياء فالدار البيضاء ونواحيها."
  },
  {
   "phrase": "s2a",
   "start": 17.55,
   "end": 19.73,
   "text": "هادو هما الأحياء اللي تبلّغ"
  },
  {
   "phrase": "s2a",
   "start": 19.73,
   "end": 21.55,
   "text": "على انقطاع الضو فيها"
  },
  {
   "phrase": "s2a",
   "start": 21.55,
   "end": 23.79,
   "text": "حسب الصحافة وبلاغ الشركة الجهوية."
  },
  {
   "phrase": "s2b",
   "start": 26.85,
   "end": 28.25,
   "text": "أما المضاءة،"
  },
  {
   "phrase": "s2b",
   "start": 28.25,
   "end": 30.79,
   "text": "فهي غير اللي ما ذكراتهاش التقارير،"
  },
  {
   "phrase": "s2b",
   "start": 30.79,
   "end": 32.3,
   "text": "وماشي لائحة رسمية."
  },
  {
   "phrase": "s3a",
   "start": 34.2,
   "end": 36.68,
   "text": "حسب Le360 نقلا عن مصدر مطلع،"
  },
  {
   "phrase": "s3a",
   "start": 36.68,
   "end": 38.52,
   "text": "العاصفة أثرت على تغذية"
  },
  {
   "phrase": "s3a",
   "start": 38.52,
   "end": 40.7,
   "text": "محطتي أولاد حدو ودار بوعزة."
  },
  {
   "phrase": "s3b",
   "start": 40.94,
   "end": 43.18,
   "text": "بجوج محطات تحويل 225/20 كيلوفولط،"
  },
  {
   "phrase": "s3b",
   "start": 43.18,
   "end": 44.68,
   "text": "ماشي محطات توليد."
  },
  {
   "phrase": "s3c",
   "start": 44.92,
   "end": 47.56,
   "text": "المكتب الوطني كينقل الكهرباء بالتوتر العالي،"
  },
  {
   "phrase": "s3c",
   "start": 47.56,
   "end": 49.83,
   "text": "والشركة الجهوية كتوزعها على الأحياء."
  },
  {
   "phrase": "s3d",
   "start": 50.07,
   "end": 51.93,
   "text": "حسب وثائق المكتب الوطني،"
  },
  {
   "phrase": "s3d",
   "start": 51.93,
   "end": 53.33,
   "text": "بجوج معلقين"
  },
  {
   "phrase": "s3d",
   "start": 53.33,
   "end": 55.87,
   "text": "على نفس الشريان ديال 225 كيلوفولط،"
  },
  {
   "phrase": "s3e",
   "start": 56.07,
   "end": 58.34,
   "text": "بين مديونة فالشمال والعوامر فالجنوب،"
  },
  {
   "phrase": "s3e",
   "start": 58.34,
   "end": 61.17,
   "text": "يعني الضو يقدر يوصلهم من جوج جهات."
  },
  {
   "phrase": "s3f",
   "start": 61.41,
   "end": 63.97,
   "text": "ووراء هاد الشريان محطات حرارية كبرى:"
  },
  {
   "phrase": "s3f",
   "start": 63.97,
   "end": 65.49,
   "text": "الجرف الأصفر وآسفي."
  },
  {
   "phrase": "s4a",
   "start": 67.09,
   "end": 68.98,
   "text": "الناطق الرسمي باسم الحكومة،"
  },
  {
   "phrase": "s4a",
   "start": 68.98,
   "end": 70.38,
   "text": "سمير بلفقيه،"
  },
  {
   "phrase": "s4a",
   "start": 70.38,
   "end": 72.2,
   "text": "قال إن الرياح طيّحات"
  },
  {
   "phrase": "s4a",
   "start": 72.2,
   "end": 74.75,
   "text": "تلاتة د الكابلات ديال الجهد العالي،"
  },
  {
   "phrase": "s4a",
   "start": 74.75,
   "end": 76.61,
   "text": "من بينهم الكابل الرئيسي."
  },
  {
   "phrase": "s4b",
   "start": 76.85,
   "end": 79.43,
   "text": "والمكتب الوطني، حسب بلاغ نقلاتو Le360،"
  },
  {
   "phrase": "s4b",
   "start": 79.43,
   "end": 81.26,
   "text": "قال إن العاصفة أتلفات"
  },
  {
   "phrase": "s4b",
   "start": 81.26,
   "end": 83.77,
   "text": "ربعة د الخطوط ديال 225 كيلوفولط"
  },
  {
   "phrase": "s4b",
   "start": 83.77,
   "end": 85.17,
   "text": "فنفس الوقت."
  },
  {
   "phrase": "s4c",
   "start": 85.41,
   "end": 87.93,
   "text": "تلاتة ولا ربعة؟ الرقم ماشي نفسو."
  },
  {
   "phrase": "s4d",
   "start": 88.17,
   "end": 90.03,
   "text": "والبلاغ ما سمّاش الخطوط،"
  },
  {
   "phrase": "s4d",
   "start": 90.03,
   "end": 92.17,
   "text": "إذن ما نقدروش نأكدو واش"
  },
  {
   "phrase": "s4d",
   "start": 92.17,
   "end": 94.39,
   "text": "الشريان ديال المحطتين من بينهم."
  },
  {
   "phrase": "s5a",
   "start": 96.19,
   "end": 98.33,
   "text": "إلا كان الضو كيقدر يوصل"
  },
  {
   "phrase": "s5a",
   "start": 98.33,
   "end": 101.2,
   "text": "من جوج جهات، كيفاش طفاو المحطتين بجوج؟"
  },
  {
   "phrase": "s5b",
   "start": 101.44,
   "end": 102.84,
   "text": "الجواب الرسمي:"
  },
  {
   "phrase": "s5b",
   "start": 102.84,
   "end": 105.34,
   "text": "ربعة د الخطوط تقطعو فمرة وحدة."
  },
  {
   "phrase": "s5c",
   "start": 105.58,
   "end": 107.38,
   "text": "وكاين خط كان مبرمج"
  },
  {
   "phrase": "s5c",
   "start": 107.38,
   "end": 109.97,
   "text": "باش يقوّي أولاد حدو: العوامر–أولاد حدو،"
  },
  {
   "phrase": "s5c",
   "start": 109.97,
   "end": 112.53,
   "text": "225 كيلوفولط مزدوج، طولو 32 كيلومتر."
  },
  {
   "phrase": "s5d",
   "start": 112.77,
   "end": 115.02,
   "text": "الشركات اللي ربحات الصفقة انسحبات،"
  },
  {
   "phrase": "s5d",
   "start": 115.02,
   "end": 117.2,
   "text": "والخط باقي متأخر حتى لليوم."
  },
  {
   "phrase": "s6a",
   "start": 119.0,
   "end": 120.5,
   "text": "على مدة الانقطاع،"
  },
  {
   "phrase": "s6a",
   "start": 120.5,
   "end": 122.66,
   "text": "الناطق الرسمي قال إن الضو"
  },
  {
   "phrase": "s6a",
   "start": 122.66,
   "end": 124.78,
   "text": "رجع من بعد تلت ساعات."
  },
  {
   "phrase": "s6b",
   "start": 125.02,
   "end": 127.19,
   "text": "ولكن فواحد الحي على الأقل،"
  },
  {
   "phrase": "s6b",
   "start": 127.19,
   "end": 129.67,
   "text": "رجع الضو حتى الحداش د الليل،"
  },
  {
   "phrase": "s6c",
   "start": 129.87,
   "end": 132.0,
   "text": "يعني أكثر من ست ساعات."
  },
  {
   "phrase": "s7a",
   "start": 134.2,
   "end": 137.1,
   "text": "باش ما يتعاودش هادشي، كاينين حلول معروفة."
  },
  {
   "phrase": "s7b",
   "start": 137.38,
   "end": 140.23,
   "text": "أولا، ربط المحطات بأكثر من خط تغذية،"
  },
  {
   "phrase": "s7b",
   "start": 140.23,
   "end": 143.03,
   "text": "باش إلا طاح خط يبقى الآخر خدام."
  },
  {
   "phrase": "s7c",
   "start": 143.35,
   "end": 146.3,
   "text": "ثانيا، فحص وصيانة الخطوط والعوازل قبل العواصف."
  },
  {
   "phrase": "s7d",
   "start": 146.62,
   "end": 149.22,
   "text": "ثالثا، حماية الخطوط والمحطات ضد الصواعق."
  },
  {
   "phrase": "s7e",
   "start": 149.54,
   "end": 151.07,
   "text": "رابعا، مراقبة الشبكة"
  },
  {
   "phrase": "s7e",
   "start": 151.07,
   "end": 153.26,
   "text": "عن قرب حسب الإنذارات الجوية."
  },
  {
   "phrase": "s7f",
   "start": 153.58,
   "end": 156.63,
   "text": "وخامسا، مولدات احتياطية للمرافق الحيوية بحال السبيطارات."
  },
  {
   "phrase": "s8a",
   "start": 159.13,
   "end": 160.96,
   "text": "أسئلة باقية بلا جواب:"
  },
  {
   "phrase": "s8b",
   "start": 161.16,
   "end": 163.41,
   "text": "علاش تلاتة فالتصريح وربعة فالبلاغ؟"
  },
  {
   "phrase": "s8c",
   "start": 163.61,
   "end": 165.11,
   "text": "علاش شريان كيتغذى"
  },
  {
   "phrase": "s8c",
   "start": 165.11,
   "end": 167.23,
   "text": "من جوج جهات طفا كامل؟"
  },
  {
   "phrase": "s8d",
   "start": 167.43,
   "end": 169.61,
   "text": "علاش خط التقوية باقي متأخر؟"
  },
  {
   "phrase": "s8e",
   "start": 169.81,
   "end": 171.68,
   "text": "وعلاش تلت ساعات فالتصريح،"
  },
  {
   "phrase": "s8e",
   "start": 171.68,
   "end": 173.47,
   "text": "وأكثر من ست ساعات"
  },
  {
   "phrase": "s8e",
   "start": 173.47,
   "end": 175.3,
   "text": "فواحد الحي على الأقل؟"
  },
  {
   "phrase": "s8f",
   "start": 175.58,
   "end": 177.43,
   "text": "ننتظرو تقرير تقني مفصل."
  }
 ],
