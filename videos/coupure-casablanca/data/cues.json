 "groups": [
  {
   "phrase": "s1a",
   "start": 0.4,
   "end": 2.59,
   "text": "مساء الأربعاء 11 نونبر 2026،"
  },
  {
   "phrase": "s1a",
   "start": 2.59,
   "end": 4.09,
   "text": "على الساعة 16:48،"
  },
  {
   "phrase": "s1b",
   "start": 4.29,
   "end": 6.79,
   "text": "وقع عطل فخطوط الجهد العالي جدا"
  },
  {
   "phrase": "s1b",
   "start": 6.79,
   "end": 9.04,
   "text": "ديال الشبكة الوطنية لنقل الكهرباء،"
  },
  {
   "phrase": "s1c",
   "start": 9.24,
   "end": 11.77,
   "text": "تزامنا مع رياح قوية وعواصف رعدية."
  },
  {
   "phrase": "s1d",
   "start": 12.01,
   "end": 13.53,
   "text": "النتيجة: انقطع الضو"
  },
  {
   "phrase": "s1d",
   "start": 13.53,
   "end": 16.45,
   "text": "على بزاف د الأحياء فالدار البيضاء ونواحيها."
  },
  {
   "phrase": "s2a",
   "start": 17.55,
   "end": 19.73,
   "text": "هادو هما الأحياء اللي تبلّغ"
  },
  {
   "phrase": "s2a",
   "start": 19.73,
   "end": 21.55,
   "text": "على انقطاع الضو فيها"
  },
  {
   "phrase": "s2a",
   "start": 21.55,
   "end": 23.79,
   "text": "حسب الصحافة وبلاغ الشركة الجهوية."
  },
  {
   "phrase": "s2b",
   "start": 26.85,
   "end": 28.25,
   "text": "أما المضاءة،"
  },
  {
   "phrase": "s2b",
   "start": 28.25,
   "end": 30.79,
   "text": "فهي غير اللي ما ذكراتهاش التقارير،"
  },
  {
   "phrase": "s2b",
   "start": 30.79,
   "end": 32.3,
   "text": "وماشي لائحة رسمية."
  },
  {
   "phrase": "s3a",
   "start": 34.2,
   "end": 36.68,
   "text": "حسب Le360 نقلا عن مصدر مطلع،"
  },
  {
   "phrase": "s3b",
   "start": 36.88,
   "end": 38.72,
   "text": "العاصفة أثرت على تغذية"
  },
  {
   "phrase": "s3b",
   "start": 38.72,
   "end": 40.9,
   "text": "محطتي أولاد حدو ودار بوعزة،"
  },
  {
   "phrase": "s3b",
   "start": 40.9,
   "end": 43.47,
   "text": "اللي كيغذيو الجزء الجنوبي من المدينة."
  },
  {
   "phrase": "s3c",
   "start": 43.75,
   "end": 46.62,
   "text": "الشركة الجهوية ما سمات حتى محطة رسميا."
  },
  {
   "phrase": "s3d",
   "start": 46.97,
   "end": 49.17,
   "text": "هاد المحطات ماشي محطات توليد،"
  },
  {
   "phrase": "s3d",
   "start": 49.17,
   "end": 50.65,
   "text": "هي محطات تحويل:"
  },
  {
   "phrase": "s3e",
   "start": 50.85,
   "end": 52.73,
   "text": "كتستقبل الكهرباء من الخطوط"
  },
  {
   "phrase": "s3e",
   "start": 52.73,
   "end": 55.65,
   "text": "ديال الجهد العالي جدا وكتوزعها على الأحياء."
  },
  {
   "phrase": "s3f",
   "start": 55.97,
   "end": 58.51,
   "text": "فاش كيتقطع الخط اللي كيدخل للمحطة،"
  },
  {
   "phrase": "s3f",
   "start": 58.51,
   "end": 60.33,
   "text": "المحطة كتبقى بلا ضو،"
  },
  {
   "phrase": "s3f",
   "start": 60.33,
   "end": 62.55,
   "text": "وكل الأحياء اللي كتغذيها كتطفى."
  },
  {
   "phrase": "s4a",
   "start": 63.75,
   "end": 66.38,
   "text": "الفرضية: الرياح القوية كتخلي الأسلاك تتحرك."
  },
  {
   "phrase": "s4b",
   "start": 66.7,
   "end": 69.22,
   "text": "إلا تلاقا سلكين، كيوقع قصر دارة،"
  },
  {
   "phrase": "s4b",
   "start": 69.22,
   "end": 71.05,
   "text": "وكيدوز تيار قوي بزاف."
  },
  {
   "phrase": "s4c",
   "start": 71.29,
   "end": 73.15,
   "text": "أجهزة الحماية كتفصل الخط"
  },
  {
   "phrase": "s4c",
   "start": 73.15,
   "end": 76.02,
   "text": "فجزء من الثانية باش ما تتخربش المعدات،"
  },
  {
   "phrase": "s4c",
   "start": 76.02,
   "end": 77.52,
   "text": "وهنا كيتقطع الضو."
  },
  {
   "phrase": "s4d",
   "start": 77.87,
   "end": 80.43,
   "text": "هادشي فرضية، والسبب الرسمي ما تحددش،"
  },
  {
   "phrase": "s4e",
   "start": 80.63,
   "end": 82.86,
   "text": "وكاين احتمالات أخرى بحال الصاعقة"
  },
  {
   "phrase": "s4e",
   "start": 82.86,
   "end": 85.35,
   "text": "أو سقوط جسم موصل على الأسلاك."
  },
  {
   "phrase": "s5a",
   "start": 87.55,
   "end": 90.45,
   "text": "باش ما يتعاودش هادشي، كاينين حلول معروفة."
  },
  {
   "phrase": "s5b",
   "start": 90.73,
   "end": 93.58,
   "text": "أولا، ربط المحطات بأكثر من خط تغذية،"
  },
  {
   "phrase": "s5b",
   "start": 93.58,
   "end": 96.38,
   "text": "باش إلا طاح خط يبقى الآخر خدام."
  },
  {
   "phrase": "s5c",
   "start": 96.7,
   "end": 99.65,
   "text": "ثانيا، فحص وصيانة الخطوط والعوازل قبل العواصف."
  },
  {
   "phrase": "s5d",
   "start": 99.97,
   "end": 102.57,
   "text": "ثالثا، حماية الخطوط والمحطات ضد الصواعق."
  },
  {
   "phrase": "s5e",
   "start": 102.89,
   "end": 104.42,
   "text": "رابعا، مراقبة الشبكة"
  },
  {
   "phrase": "s5e",
   "start": 104.42,
   "end": 106.61,
   "text": "عن قرب حسب الإنذارات الجوية."
  },
  {
   "phrase": "s5f",
   "start": 106.93,
   "end": 109.98,
   "text": "وخامسا، مولدات احتياطية للمرافق الحيوية بحال السبيطارات."
  },
  {
   "phrase": "s6a",
   "start": 112.48,
   "end": 113.88,
   "text": "سؤال مطروح:"
  },
  {
   "phrase": "s6a",
   "start": 113.88,
   "end": 116.46,
   "text": "الدار البيضاء عرفات رياح قوية فالماضي،"
  },
  {
   "phrase": "s6b",
   "start": 116.66,
   "end": 119.48,
   "text": "علاش هاد المرة تأثر أكثر من موقع؟"
  },
  {
   "phrase": "s6c",
   "start": 119.8,
   "end": 121.29,
   "text": "الجواب ما مؤكدش."
  },
  {
   "phrase": "s6d",
   "start": 121.53,
   "end": 124.11,
   "text": "من الاحتمالات: اجتماع الرياح مع الرعد،"
  },
  {
   "phrase": "s6e",
   "start": 124.31,
   "end": 126.16,
   "text": "وقوع العطل فوقت الذروة،"
  },
  {
   "phrase": "s6f",
   "start": 126.36,
   "end": 129.21,
   "text": "أو خط مشترك كيغذي محطتين فنفس الوقت."
  },
  {
   "phrase": "s6g",
   "start": 129.53,
   "end": 131.04,
   "text": "ننتظرو تقرير رسمي."
  }
 ],
